{
  "name": "@kashifmuhammad/agent-inspector",
  "version": "0.1.2",
  "description": "CLI to inspect LangGraph agent trajectories locally - zero infra, localhost only",
  "type": "module",
  "bin": {
    "agent-inspector": "./bin/agent-inspector.js"
  },
  "files": [
    "bin",
    "dist",
    "app",
    "src",
    "public",
    "next-env.d.ts",
    "tsconfig.json",
    "next.config.mjs",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm --filter @kashifmuhammad/agent-inspector-core build && pnpm --filter @kashifmuhammad/agent-inspector-react build && tsup && next build",
    "dev": "tsx src/cli.ts --log ../../examples/mock-run.json --no-open",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .next"
  },
  "dependencies": {
    "@kashifmuhammad/agent-inspector-core": "^0.1.1",
    "@kashifmuhammad/agent-inspector-react": "^0.1.1",
    "commander": "^12.1.0",
    "next": "^14.2.21",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}

