{
  "framework": "vercel-ai",
  "runId": "run_vercel_demo",
  "messages": [
    {
      "role": "user",
      "content": "Summarize ticket TICKET-1001 and mark it resolved."
    },
    {
      "role": "assistant",
      "parts": [
        {
          "type": "text",
          "text": "I'll read the ticket, then update its status."
        },
        {
          "type": "tool-call",
          "toolCallId": "tc_read",
          "toolName": "read_ticket",
          "args": { "ticketId": "TICKET-1001" }
        }
      ]
    },
    {
      "role": "tool",
      "content": [
        {
          "type": "tool-result",
          "toolCallId": "tc_read",
          "toolName": "read_ticket",
          "result": {
            "ticketId": "TICKET-1001",
            "summary": "Customer needs a fresh portal link for ORD-4821"
          }
        }
      ]
    },
    {
      "role": "assistant",
      "parts": [
        {
          "type": "tool-call",
          "toolCallId": "tc_update",
          "toolName": "update_ticket_status",
          "args": { "ticketId": "TICKET-1001", "status": "resolved" }
        }
      ]
    },
    {
      "role": "tool",
      "content": [
        {
          "type": "tool-result",
          "toolCallId": "tc_update",
          "toolName": "update_ticket_status",
          "result": { "status": "resolved" }
        }
      ]
    },
    {
      "role": "assistant",
      "parts": [
        {
          "type": "text",
          "text": "Ticket TICKET-1001 summarized and marked resolved."
        }
      ]
    }
  ]
}
