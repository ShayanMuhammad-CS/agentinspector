{
  "name": "agent-inspector-monorepo",
  "private": true,
  "version": "0.1.4",
  "description": "Visualize LangGraph agent trajectories and gate risky actions behind human approval",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @kashifmuhammad/agent-inspector dev",
    "dev:cli": "pnpm --filter @kashifmuhammad/agent-inspector start -- --log examples/mock-run.json",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0",
  "license": "MIT"
}
